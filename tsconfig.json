{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@limits-apply/intelligence": ["packages/intelligence/src/index.ts"],
      "@limits-apply/sources": ["packages/sources/src/normalize.ts"],
      "@limits-apply/gate": ["packages/gate/src/litellm.ts"]
    },
    "types": ["vite/client", "node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src", "test", "packages", "vite.config.ts"]
}
